# environment
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# experiment tracking (local file store; see doc/decision_log.md)
mlruns/
mlartifacts/

# DVC adds its own data/raw/.gitignore entry for the tracked file after `dvc add`

# data/interim/ is regenerable scratch (WBS 0.2: "میانی") — never a locked snapshot,
# not worth versioning; reproduce with `python -m src.data.make_dataset`
data/interim/*
!data/interim/.gitkeep

# jupyter
.jupyter/

# اجرای GPU (بند 7.8 فاز ۷) — همه بازتولیدپذیر یا حجیم‌اند، نه منبع حقیقت:
#   gpu_bundle.zip  = بسته‌ی آپلود، با `make gpu-bundle` دوباره ساخته می‌شود
#   gpu_outputs/    = تکه‌های zip برگشتی از کولب (تا ۱۰۰ مگابایت هرکدام)
#   mlruns_gpu/     = پس از ادغام در mlruns/ دیگر لازم نیست
#   models/gpu/     = وزن مدل‌های سنگین؛ از راه همان zip تکه‌تکه توزیع می‌شوند
gpu_bundle.zip
gpu_outputs/
mlruns_gpu/
models/gpu/
